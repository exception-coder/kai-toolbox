top;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="610" y="750" width="380" height="123" as="geometry"/></mxCell><mxCell id="c19" value="&lt;div style=&quot;font-weight:700;font-size:14px&quot;&gt;claude_chat_review_todo&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;margin-bottom:6px&quot;&gt;原会话中的评审待办&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;border-top:1px solid #e11d48;padding-top:6px&quot;&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;review_space_id + requirement_id&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;+ source_revision 需求版本，三者唯一&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;status 默认 WAITING · version&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;verticalAlign=top;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="610" y="930" width="380" height="123" as="geometry"/></mxCell><mxCell id="c20" value="资源与 SQL 登记" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#64748b;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="1150" y="710" width="420" height="380" as="geometry"/></mxCell><mxCell id="c21" value="&lt;div style=&quot;font-weight:700;font-size:14px&quot;&gt;claude_chat_pending_sql&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;margin-bottom:6px&quot;&gt;待执行 SQL 台账（只登记不执行）&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;border-top:1px solid #64748b;padding-top:6px&quot;&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;session_id 主键（每会话一条）&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;target_environment · sql_text&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;status PENDING / EXECUTED / CANCELLED&lt;/div&gt;&lt;div style=&quot;text-align:lef