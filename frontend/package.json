{
  "name": "kai-toolbox-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-feature-permissions.mjs && npm run assistant:release",
    "dev": "vite",
    "build": "node scripts/generate-feature-permissions.mjs && npm run assistant:release && npm run session-client:build && npm run architecture:check && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/generate-feature-permissions.mjs --check && npm run architecture:check && tsc -b --noEmit",
    "architecture:check": "node scripts/check-feature-boundaries.mjs",
    "feature-catalog:generate": "node scripts/generate-feature-permissions.mjs",
    "feature-catalog:check": "node scripts/generate-feature-permissions.mjs --check",
    "h5:dev": "vite --config vite.standalone.config.ts",
    "h5:build": "node scripts/build-standalone-page.mjs --id supplier-quote-h5",
    "h5:preview": "vite preview --config vite.standalone.config.ts",
    "assistant:build": "vite build --config vite.assistant.config.ts && tsc -p tsconfig.assistant.json",
    "assistant:loader:build": "vite build --config vite.assistant-loader.config.ts",
    "assistant:release:test": "node --test scripts/publish-assistant-release.test.mjs",
    "assistant:release": "npm run assistant:release:test && npm run assistant:build && npm run assistant:loader:build && node scripts/publish-assistant-release.mjs",
    "assistant:release:canary": "npm run assistant:release:test && npm run assistant:build && npm run assistant:loader:build && node scripts/publish-assistant-release.mjs --channel=canary",
    "session-client:build": "vite build --config vite.session-client.config.ts && tsc -p tsconfig.session-client.json",
    "java8gu:sync": "node scripts/build-java8gu-index.mjs",
    "webppt-report:quant": "node scripts/generate-webppt-quant-data.mjs"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.62.7",
    "@types/crypto-js": "^4.2.2",
    "@types/dompurify": "^3.0.5",
    "@uiw/react-codemirror": "^4.25.9",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.2",
    "hls.js": "^1.6.16",
    "html-to-image": "^1.11.13",
    "js-yaml": "^4.1.1",
    "jsencrypt": "^3.5.4",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.3",
    "mermaid": "^11.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-3d": "^1.29.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.1.1",
    "react-virtuoso": "^4.18.11",
    "recharts": "^2.15.0",
    "reveal.js": "^5.2.1",
    "shiki": "^4.1.0",
    "sql-formatter": "^15.8.0",
    "tailwind-merge": "^2.5.5",
    "xml-formatter": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/reveal.js": "^5.2.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-mkcert": "^1.17.12",
    "vitest": "^3.2.7"
  }
}
