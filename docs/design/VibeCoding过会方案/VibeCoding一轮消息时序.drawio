<mxfile host="drawio"><diagram id="seq" name="一轮消息"><mxGraphModel dx="1500" dy="1150" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="1120" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s2" value="&lt;b&gt;一轮消息的处理、授权与恢复&lt;/b&gt;" style="text;html=1;fontSize=22;fontColor=#0f172a;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1440" height="40" as="geometry"/></mxCell><mxCell id="s3" value="依据 docs/architecture/vibe-coding-架构与实现.md 与当前源码；浏览器↔宿主、宿主↔Sidecar 是两条独立 WebSocket，Sidecar 只监听本机。" style="text;html=1;fontSize=13;fontColor=#475569;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1440" height="40" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b style=&quot;font-size:15px&quot;&gt;浏览器&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569&quot;&gt;手机 / 平板 / 桌面&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="260" height="60" as="geometry"/></mxCell><mxCell id="s5" value="" style="endArrow=none;dashed=1;strokeColor=#94a3b8;strokeWidth=1.2;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="160" as="sourcePoint"/><mxPoint x="180" y="1040" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s6" value="&lt;b style=&quot;font-size:15px&quot;&gt;Forge Java 宿主&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569&quot;&gt;会话、队列、权限、推进&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="260" height="60" as="geometry"/></mxCell><mxCell id="s7" value="" style="endArrow=none;dashed=1;strokeColor=#94a3b8;strokeWidth=1.2;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="160" as="sourcePoint"/><mxPoint x="560" y="1040" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s8" value="&lt;b style=&quot;font-size:15px&quot;&gt;Node Sidecar&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569&quot;&gt;引擎适配与约束注入&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="810" y="100" width="260" height="60" as="geometry"/></mxCell><mxCell id="s9" value="" style="endArrow=none;dashed=1;strokeColor=#94a3b8;strokeWidth=1.2;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="160" as="sourcePoint"/><mxPoint x="940" y="1040" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s10" value="&lt;b style=&quot;font-size:15px&quot;&gt;原生引擎&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569&quot;&gt;Codex / Claude Code 等&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1190" y="100" width="260" height="60" as="geometry"/></mxCell><mxCell id="s11" value="" style="endArrow=none;dashed=1;strokeColor=#94a3b8;strokeWidth=1.2;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="160" as="sourcePoint"/><mxPoint x="1320" y="1040" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s12" value="① 发送消息（运行中默认加入队列）" style="endArrow=block;endFill=1;strokeColor=#1e293b;strokeWidth=1.4;html=1;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="200" as="sourcePoint"/><mxPoint x="560" y="200" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s13" value="② 写入持久队列；空闲时准入本轮" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="440" y="250" width="240" height="40" as="geometry"/></mxCell><mxCell id="s14" value="③ 派发本轮：会话标识、上下文、团队约束" style="endArrow=block;endFill=1;strokeColor=#1e293b;strokeWidth=1.4;html=1;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="320" as="sourcePoint"/><mxPoint x="940" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s15" value="④ 按原生会话句柄续接（resume）" style="endArrow=block;endFill=1;strokeColor=#1e293b;strokeWidth=1.4;html=1;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="370" as="sourcePoint"/><mxPoint x="1320" y="370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s16" value="⑤ 流式输出" style="endArrow=open;endFill=0;dashed=1;strokeColor=#475569;strokeWidth=1.2;html=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="430" as="sourcePoint"/><mxPoint x="940" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s17" value="转换为统一事件" style="endArrow=open;endFill=0;dashed=1;strokeColor=#475569;strokeWidth=1.2;html=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="460" as="sourcePoint"/><mxPoint x="560" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s18" value="逐段推送到页面" style="endArrow=open;endFill=0;dashed=1;strokeColor=#475569;strokeWidth=1.2;html=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="490" as="sourcePoint"/><mxPoint x="180" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s19" value="⑥ 需要执行工具：引擎回调挂起，等待用户决定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="820" y="540" width="620" height="44" as="geometry"/></mxCell><mxCell id="s20" value="授权请求（请求编号配对）" style="endArrow=open;endFill=0;dashed=1;strokeColor=#475569;strokeWidth=1.2;html=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="610" as="sourcePoint"/><mxPoint x="560" y="610" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s21" value="弹出授权确认" style="endArrow=open;endFill=0;dashed=1;strokeColor=#475569;strokeWidth=1.2;html=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="640" as="sourcePoint"/><mxPoint x="180" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s22" value="⑦ 允许 / 拒绝" style="endArrow=block;endFill=1;strokeColor=#1e293b;strokeWidth=1.4;html=1;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180" y="690" as="sourcePoint"/><mxPoint x="560" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s23" value="回灌决定" style="endArrow=block;endFill=1;strokeColor=#1e293b;strokeWidth=1.4;html=1;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="720" as="sourcePoint"/><mxPoint x="940" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s24" value="放行或拒绝工具调用" style="endArrow=block;endFill=1;strokeColor=#1e293b;strokeWidth=1.4;html=1;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="750" as="sourcePoint"/><mxPoint x="1320" y="750" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s25" value="⑧ 本轮结束" style="endArrow=open;endFill=0;dashed=1;strokeColor=#475569;strokeWidth=1.2;html=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1320" y="800" as="sourcePoint"/><mxPoint x="940" y="800" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s26" value="结果回执" style="endArrow=open;endFill=0;dashed=1;strokeColor=#475569;strokeWidth=1.2;html=1;fontSize=12;fontColor=#334155;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="830" as="sourcePoint"/><mxPoint x="560" y="830" as="targetPoint"/></mxGeometry></mxCell><mxCell id="s27" value="⑨ 完成核对：确认收口后放行下一条；&lt;br&gt;结果不明最多核对三次再挂起" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="440" y="870" width="240" height="56" as="geometry"/></mxCell><mxCell id="s28" value="&lt;b&gt;浏览器断线&lt;/b&gt;：任务继续在宿主运行；重连后按事件序号回放并补发未送达消息" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="620" height="52" as="geometry"/></mxCell><mxCell id="s29" value="&lt;b&gt;Sidecar 崩溃&lt;/b&gt;：会话标为中断；宿主重启进程后，用保存的原生句柄续接上下文" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="820" y="960" width="620" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>