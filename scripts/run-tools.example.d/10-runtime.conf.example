# 复制到 ../run-tools.d/10-runtime.conf 后填写；实际目录受 Git 忽略。
MVN_CMD=
JAVA_CMD=
NPM_CMD=
PYTHON_CMD=
GIT_CMD=
ARIA2_BIN=

# Unified Node supervisor (optional overrides)
FORGE_SCOPE=all
FORGE_MODE=dev
FORGE_VISITOR_ANALYSIS_ENABLED=true
# Leave empty for platform default: enabled only on Windows
FORGE_WECHAT_ENABLED=
FORGE_STUDIO_ENABLED=false
FORGE_OBSERVABILITY=external
