&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;verticalAlign=top;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="1170" y="400" width="380" height="123" as="geometry"/></mxCell><mxCell id="c13" value="&lt;div style=&quot;font-weight:700;font-size:14px&quot;&gt;claude_chat_autopilot_batch&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;margin-bottom:6px&quot;&gt;多个规格变更批量推进&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;border-top:1px solid #d97706;padding-top:6px&quot;&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;session_id 主键 · run_id（外键）&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;current_index 当前序号&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=1.5;verticalAlign=top;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="1170" y="560" width="380" height="104" as="geometry"/></mxCell><mxCell id="c14" value="轮次与附件" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7c3aed;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#7c3aed;" vertex="1" parent="1"><mxGeometry x="30" y="710" width="420" height="380" as="geometry"/></mxCell><mxCell id="c15" value="&lt;div style=&quot;font-weight:700;font-size:14px&quot;&gt;claude_chat_turn_change&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;margin-bottom:6px&quot;&gt;每轮 Git 基线与文件变化&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;border-top:1px solid #7c3aed;padding-top:6px&quot;&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;(session_id, turn_id) 主键 · session_id 外键&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;payload 变化路径与提交区间（不含文件正文）&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWid