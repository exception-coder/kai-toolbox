<mxfile host="drawio"><diagram id="er" name="核心对象与表模型"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1160" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Vibe Coding 核心对象与表模型&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c3" value="逻辑视图 · 2026-11-10 · 来源 tool-claude-chat 的 SQLite DDL（共 44 张表，图中为核心 15 张）。实线：数据库外键（级联删除）；虚线：应用层逻辑关联。对话正文不在 Forge 库中，保存在各引擎原生记录。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c4" value="消息队列：发送、派发与完成核对" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#059669;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#059669;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="420" height="560" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;font-weight:700;font-size:14px&quot;&gt;claude_chat_queued_message&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;margin-bottom:6px&quot;&gt;待发送消息&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;border-top:1px solid #059669;padding-top:6px&quot;&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;id 主键&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;session_id 所属会话&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;text / attachments_json 正文与附件&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;created_at 入队时间&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;verticalAlign=top;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="380" height="142" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style=&quot;font-weight:700;font-size:14px&quot;&gt;claude_chat_queue_runtime&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;margin-bottom:6px&quot;&gt;本轮能否收口、能否放行下一条&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;border-top:1px solid #059669;padding-top:6px&quot;&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;session_id 主键（每会话一行）&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;turn_id 当前轮次&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;release_ready / checking / check_attempts&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;stop_reason 暂停原因&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;verticalAlign=top;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="320" width="380" height="142" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style=&quot;font-weight:700;font-size:14px&quot;&gt;claude_chat_queue_delivery&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;margin-bottom:6px&quot;&gt;派发与接收回执&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;border-top:1px solid #059669;padding-top:6px&quot;&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;session_id 主键 · message_id 唯一&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;status / attempts / retry_at&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;verticalAlign=top;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="50" y="510" width="380" height="104" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;font-weight:700;font-size:14px&quot;&gt;claude_chat_session&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;margin-bottom:6px&quot;&gt;会话：Forge 侧唯一身份&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;border-top:1px solid #2563eb;padding-top:6px&quot;&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;id 主键 · cwd 工作目录 · title&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;engine 当前引擎 · engines 用过的引擎&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;engine_sessions 各引擎原生会话句柄（JSON）&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;selected_model · permission_mode · execution_policy&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;group_name · favorite&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;status RUNNING / IDLE / INTERRUPTED / DONE&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;started_at · last_seen_at&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=1.5;verticalAlign=top;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="580" y="150" width="440" height="199" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style=&quot;font-weight:700;font-size:14px&quot;&gt;引擎原生会话记录（不在 Forge 库）&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#475569;margin-bottom:6px&quot;&gt;Codex rollout、Claude JSONL 等&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;border-top:1px solid #64748b;padding-top:6px&quot;&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;对话正文与工具过程的事实来源&lt;/div&gt;&lt;div style=&quot;text-align:left;padding:1px 0&quot;&gt;按句柄续接，Sidecar 重启不丢上下文&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;strokeWidth=1.5;verticalAlign=top;align=center;spacing=10;" vertex="1" parent="1"><mxGeometry x="720" y="500" width="300" height="104" as="geometry"/></mxCell><mxCell id="c10" va