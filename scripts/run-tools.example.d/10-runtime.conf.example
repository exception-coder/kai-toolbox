# 复制到 ../run-tools.d/10-runtime.conf 后填写；实际目录受 Git 忽略。
MVN_CMD=
JAVA_CMD=
NPM_CMD=
PYTHON_CMD=
GIT_CMD=
ARIA2_BIN=

# Unified Node supervisor (optional overrides)
FORGE_SCOPE=all
FORGE_MODE=dev
# Independent frontend runtime, committed snapshots only in static mode.
FORGE_FRONTEND_MODE=dev
FORGE_FRONTEND_AUTO_BUILD=true
FORGE_FRONTEND_POLL_SECONDS=15
# Optional existing TLS leaf certificate/key; defaults to ~/.vite-plugin-mkcert/.
FORGE_FRONTEND_TLS_CERT=
FORGE_FRONTEND_TLS_KEY=
FORGE_STUDIO_ENABLED=false
FORGE_OBSERVABILITY=external
# 配置好命名隧道后设为 true；随项目启动并由 PM2 限次重启。
FORGE_CLOUDFLARE_ENABLED=false
FORGE_CLOUDFLARE_CONFIG=
FORGE_CLOUDFLARE_PROTOCOL=http2
