# Wyoooni 自有宿主：企业账号 Oracle 校验库
WYOOONI_ACCOUNT_ORACLE_ENABLED=false
WYOOONI_ACCOUNT_ORACLE_URL=
WYOOONI_ACCOUNT_ORACLE_USERNAME=
WYOOONI_ACCOUNT_ORACLE_PASSWORD=

# Wyoooni 生产宿主：H5 业务 Oracle 主库
WYOOONI_BUSINESS_DB_URL=
WYOOONI_BUSINESS_DB_USERNAME=
WYOOONI_BUSINESS_DB_PASSWORD=
WYOOONI_BUSINESS_DB_MAXIMUM_POOL_SIZE=20
WYOOONI_BUSINESS_DB_MINIMUM_IDLE=5
WYOOONI_BUSINESS_DB_CONNECTION_TIMEOUT_MS=10000
WYOOONI_BUSINESS_DB_VALIDATION_TIMEOUT_MS=5000
WYOOONI_BUSINESS_DB_IDLE_TIMEOUT_MS=600000
WYOOONI_BUSINESS_DB_MAX_LIFETIME_MS=1800000
WYOOONI_BUSINESS_DB_KEEPALIVE_TIME_MS=120000

# Forge 宿主：供应商报价 Oracle 校验库
SUPPLIER_QUOTE_ORACLE_ENABLED=false
SUPPLIER_QUOTE_ORACLE_URL=
SUPPLIER_QUOTE_ORACLE_USERNAME=
SUPPLIER_QUOTE_ORACLE_PASSWORD=

# 供应商报价微信公众号
SUPPLIER_QUOTE_WECHAT_MODE=mock
SUPPLIER_QUOTE_WECHAT_APP_ID=
SUPPLIER_QUOTE_WECHAT_APP_SECRET=

# SRM 市场报价 Open API（密钥只放本地配置，不提交 Git）
SUPPLIER_QUOTE_MARKET_PROVIDER=srm-http
SUPPLIER_QUOTE_SRM_BASE_URL=
SUPPLIER_QUOTE_SRM_SECRET_KEY=
SUPPLIER_QUOTE_SRM_CONNECT_TIMEOUT_MS=5000
SUPPLIER_QUOTE_SRM_REQUEST_TIMEOUT_MS=10000

# 移动端市场报价 MySQL 闭环（provider=mysql 时启用）
SUPPLIER_QUOTE_MARKET_MYSQL_URL=
SUPPLIER_QUOTE_MARKET_MYSQL_USERNAME=
SUPPLIER_QUOTE_MARKET_MYSQL_PASSWORD=
SUPPLIER_QUOTE_MARKET_MYSQL_MAXIMUM_POOL_SIZE=10
SUPPLIER_QUOTE_MARKET_MYSQL_MINIMUM_IDLE=2
SUPPLIER_QUOTE_MARKET_MYSQL_CONNECTION_TIMEOUT=10s
SUPPLIER_QUOTE_MARKET_MYSQL_VALIDATION_TIMEOUT=5s
SUPPLIER_QUOTE_MARKET_MYSQL_IDLE_TIMEOUT=10m
SUPPLIER_QUOTE_MARKET_MYSQL_MAX_LIFETIME=30m
SUPPLIER_QUOTE_MARKET_MYSQL_KEEPALIVE_TIME=2m

# Wyoooni 自有宿主运行环境
WYOOONI_SERVER_PORT=18090
WYOOONI_SQLITE_FILE=
