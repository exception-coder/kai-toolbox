{
  "name": "claude-chat-sidecar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "kai-toolbox 移动端 Claude 客户端的 sidecar：跑 Claude Agent SDK，经 WebSocket 与 Java 后端交互",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "npm run build && node --test dist/**/*.test.js",
    "start": "node dist/server.js",
    "dev": "node --experimental-strip-types src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@deepseek-ai/dsh-sdk-client": "0.1.0-rc.6",
    "@google/gemini-cli": "^0.45.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "^0.147.0",
    "@opencode-ai/sdk": "^1.17.7",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  }
}
