# 复制为 .env 后填写。不要将 .env 提交到 Git。
# 服务器生成 32 字节随机值：openssl rand -hex 32

LANGFUSE_IMAGE_TAG=4
POSTGRES_VERSION=17

# 外部访问地址，启用 HTTPS 后必须改为真实域名。
NEXTAUTH_URL=https://langfuse.example.com
LANGFUSE_WEB_BIND_ADDRESS=127.0.0.1
LANGFUSE_WEB_PORT=3000

# 每一项使用不同的随机值。ENCRYPTION_KEY 必须是 64 位十六进制字符。
NEXTAUTH_SECRET=replace-with-random-hex
SALT=replace-with-random-hex
ENCRYPTION_KEY=replace-with-64-char-random-hex

POSTGRES_USER=langfuse
POSTGRES_PASSWORD=replace-with-random-hex
POSTGRES_DB=langfuse

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=replace-with-random-hex

REDIS_AUTH=replace-with-random-hex

MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=replace-with-random-hex

# 关闭 Langfuse 自身匿名使用统计；不影响 kai-toolbox Trace。
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# 可选：需要无人值守初始化时再填写，否则首次打开页面手工创建用户、组织和项目。
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_RETENTION=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
